# ─────────────────────────────────────────────────────────────
# BezaMint — Environment Variables
# ─────────────────────────────────────────────────────────────
# Copy this file to apps/web/.env.local and fill in your values:
#   cp .env.example apps/web/.env.local
# ─────────────────────────────────────────────────────────────

# ── Stellar Network ──────────────────────────────────────────

# Network selection: "testnet" or "mainnet"
NEXT_PUBLIC_STELLAR_NETWORK=testnet

# Soroban RPC endpoint
NEXT_PUBLIC_STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# Network passphrase
NEXT_PUBLIC_STELLAR_PASSPHRASE="Test SDF Network ; September 2015"

# Horizon server URL (used for balance lookups)
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org

# Stellar Explorer base URL
NEXT_PUBLIC_EXPLORER_URL=https://stellar.expert/explorer/testnet

# ── Deployed Contract IDs (Testnet) ──────────────────────────
# Generated automatically by scripts/deploy.sh

NEXT_PUBLIC_NFT_CONTRACT_ID=
NEXT_PUBLIC_COLLECTION_CONTRACT_ID=
NEXT_PUBLIC_ROYALTY_CONTRACT_ID=
NEXT_PUBLIC_CREATOR_CONTRACT_ID=
NEXT_PUBLIC_FACTORY_CONTRACT_ID=

# Optional: Contract Wasm hashes for deployment verification
NEXT_PUBLIC_NFT_CONTRACT_HASH=
NEXT_PUBLIC_COLLECTION_CONTRACT_HASH=
NEXT_PUBLIC_ROYALTY_CONTRACT_HASH=
NEXT_PUBLIC_CREATOR_CONTRACT_HASH=

# ── IPFS (Pinata) ────────────────────────────────────────────

# Pinata JWT for IPFS uploads (get one at https://pinata.cloud)
#
# Scope the key to pinFileToIPFS + pinJSONToIPFS only: the upload route is
# reachable from any visitor of a public deployment, so a key with broader
# permissions would let them spend quota on anything the account allows.
# See docs/pinata-key-rotation.md.
# Leave empty to use beza:// placeholder fallback URIs -- but note that a
# minted metadata_uri is immutable on chain, so a placeholder URI produced here
# is permanent for that token.
PINATA_JWT=

# Gateway the app READS through. Public by design: it ships in the client
# bundle (only the JWT is a secret).
#
# Any gateway serves byte-identical content for a CID, so this is a latency
# choice, not a trust one. The default is https://ipfs.io because Pinata's
# public gateway measured 3.7-6.6s per object against ~40ms for ipfs.io.
#
# Note the trade: public gateways rate-limit datacenter egress, and ipfs.io,
# dweb.link, w3s.link and nftstorage.link all answered 429 to this project's
# serverless egress for objects a browser read fine. Server-side paths
# therefore always keep the pinning provider's gateway behind this one (see
# FALLBACK_IPFS_GATEWAY in apps/web/src/lib/ipfsGateway.ts) and step over a
# refusal. Reads that must not be throttled at all -- a high-traffic
# production deployment -- want a Pinata dedicated gateway here instead.
NEXT_PUBLIC_PINATA_GATEWAY=https://ipfs.io

# ── Server API hardening ─────────────────────────────────────

# Shared secret for callers that are not a browser, sent as `x-api-key` on
# mutating (POST/PUT/PATCH/DELETE) /api/* requests. Enforced by
# apps/web/src/middleware.ts.
#
# Two callers, two rules. A script or a service can hold a secret and presents
# it here. A browser cannot hold a secret without publishing it, so the app's own
# UI is trusted by origin instead — an `Origin` (or `Referer`) matching the host
# the request was addressed to, or an entry in CORS_ALLOWED_ORIGINS. A mutating
# request from any other origin is refused with 403 whether or not this is set.
#
# Set it in production so non-browser callers have to authenticate. When unset, a
# caller with no Origin is not asked for anything beyond the per-IP rate limit.
API_WRITE_KEY=

# Comma-separated list of origins allowed to call the API routes from a
# browser. Defaults to same-origin only when unset.
CORS_ALLOWED_ORIGINS=

# How far back the event indexer looks on a cold start, in ledgers.
#
# Two different limits matter here and they are not the same number. Soroban
# RPC's getHealth() reports a ledgerRetentionWindow of ~120,960 ledgers (~7
# days), which is the range a startLedger may fall in -- but *events* are
# retained for far less. Measured against the public testnet RPC: requests were
# answered from as far back as ~10,500 ledgers, and with zero events from
# 11,000. The zero is not an error, so a window set too wide fails silently with
# a permanently empty event feed rather than reporting anything.
#
# The value is therefore clamped to 10,000: it can narrow the search but not
# widen it past what the RPC will actually serve events from. Leave it at the
# default unless a node is known to retain a different amount.
INDEXER_LOOKBACK_LEDGERS=10000

# ── App Metadata ─────────────────────────────────────────────

# Display name used in metadata, Open Graph tags and the manifest
NEXT_PUBLIC_APP_NAME=BezaMint

# Public base URL of the deployment (used for absolute Open Graph URLs)
NEXT_PUBLIC_APP_URL=http://localhost:3000
