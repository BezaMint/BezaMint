{
  "name": "bezamint",
  "version": "0.1.0",
  "private": true,
  "description": "A comprehensive NFT creation and digital asset management platform built on the Stellar network using Soroban smart contracts.",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "contract:build": "cargo build --workspace --release --target wasm32-unknown-unknown --manifest-path contracts/Cargo.toml",
    "contract:test": "cargo test --workspace --manifest-path contracts/Cargo.toml",
    "contract:wasm": "cargo build --workspace --release --target wasm32-unknown-unknown --manifest-path contracts/Cargo.toml",
    "contract:verify": "bash scripts/verify-deploy.sh",
    "contract:size": "bash scripts/check-wasm-size.sh",
    "bundle:size": "bash scripts/check-bundle-size.sh",
    "contract:abi": "python3 scripts/check-contract-abi.py",
    "contract:abi:update": "python3 scripts/check-contract-abi.py --write",
    "contract:errors": "python3 scripts/generate-error-catalog.py --write",
    "contract:errors:check": "python3 scripts/generate-error-catalog.py",
    "errors:check": "python3 scripts/check-error-codes.py",
    "errors:list": "python3 scripts/check-error-codes.py --list",
    "contract:bench": "python3 scripts/bench-contract-resources.py --write",
    "contract:bench:check": "python3 scripts/bench-contract-resources.py",
    "deploy:record:check": "python3 scripts/check-deployment-record.py",
    "demo:metadata": "node scripts/generate-demo-metadata.mjs",
    "demo:metadata:check": "node scripts/generate-demo-metadata.mjs --check",
    "demo:seed": "bash scripts/seed-testnet-activity.sh",
    "smoke": "bash scripts/smoke-test.sh",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,toml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,toml,yaml}\"",
    "clean": "turbo run clean",
    "prepare": "husky",
    "contract:check": "cargo check --workspace --manifest-path contracts/Cargo.toml",
    "contract:clippy": "cargo clippy --workspace --manifest-path contracts/Cargo.toml -- -D warnings",
    "contract:fmt": "cargo fmt --all --manifest-path contracts/Cargo.toml -- --check",
    "screenshots:capture": "node scripts/capture-screenshots.mjs"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.4",
  "pnpm": {
    "overrides": {
      "nanoid@<3.3.18": "^3.3.18",
      "js-yaml@<4.3.2": "^4.3.2",
      "postcss@<8.5.23": "^8.5.23",
      "sharp@<0.35.4": "^0.35.4",
      "toml@<4.3.0": "^4.3.0"
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "husky": "^9.1.7",
    "prettier": "^3.4.2",
    "turbo": "^2.10.12"
  }
}
