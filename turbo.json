{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalDependencies": ["**/.env.*local", "**/.env"],
  "globalEnv": [
    "NODE_ENV",
    "NEXT_PUBLIC_STELLAR_NETWORK",
    "NEXT_PUBLIC_STELLAR_RPC_URL",
    "NEXT_PUBLIC_STELLAR_PASSPHRASE",
    "NEXT_PUBLIC_FACTORY_CONTRACT_ID",
    "NEXT_PUBLIC_NFT_CONTRACT_HASH",
    "NEXT_PUBLIC_COLLECTION_CONTRACT_HASH"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "dist/**", "target/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"]
    },
    "test": {
      "inputs": ["src/**", "test/**", "tests/**"],
      "outputs": ["coverage/**"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "clean": {
      "cache": false
    },
    "contract:build": {
      "cache": false,
      "outputs": ["contracts/target/**"]
    },
    "contract:test": {
      "dependsOn": ["contract:build"],
      "cache": false
    }
  }
}
